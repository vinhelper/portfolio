# Copy to .env and fill in. .env is gitignored; this sample is committed.
# Vite only exposes variables prefixed with VITE_, and it inlines them into the
# client bundle at build time, so treat every value here as public.
# Restart `npm run dev` after editing, since env vars are read at server start.

# EmailJS, used by src/components/Contact.jsx to send the contact form.
# All three come from https://dashboard.emailjs.com (Email Services, Email
# Templates, and Account > General). Without them the form fails on submit and
# reports the inline error state.
# The public key is safe to ship by design, but lock the account down under
# Account > Security > Allowed Domains so it only works from your own origin.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# If the form ever moves to Resend, its key must NOT live here: it is a server
# secret and anything VITE_-prefixed ends up in the bundle. It would go in a
# serverless function's own environment as RESEND_API_KEY instead.
